{
  // service worker(src/sw)だけの型チェック。画面側(DOM)とは別の型(webworker)を使うため、分けている
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src/sw", "src/core/tiles.ts", "src/core/share.ts"]
}
